(()=>{"use strict";window.setCookieBySecond=function(e,t,n){var o="";if(n){var i=new Date;i.setTime(i.getTime()+1e3*n),o="; expires="+i.toUTCString()}document.cookie=e+"="+(t||"")+o+"; path=/"},window.deleteCookie=function(e){document.cookie=e+"=; Max-Age=-99999999;"},window.getCookie=function(e){for(var t=e+"=",n=document.cookie.split(";"),o=0;o<n.length;o++){for(var i=n[o];" "==i.charAt(0);)i=i.substring(1,i.length);if(0==i.indexOf(t))return i.substring(t.length,i.length)}return null}})();